# ============================================
# LOKAL (SQLite)
# ============================================
# 1. Copy schema: cp prisma/schema.sqlite.prisma prisma/schema.prisma
# 2. Set DATABASE_URL ke file SQLite
# 3. Jalankan: bun run db:push

# DATABASE_URL="file:./db/custom.db"

# ============================================
# PRODUKSI (Supabase / PostgreSQL)
# ============================================
# 1. Copy schema: cp prisma/schema.postgresql.prisma prisma/schema.prisma
#    (atau biarkan default yang sudah postgresql)
# 2. Set DATABASE_URL ke connection string Supabase
# 3. Jalankan: bun run db:push atau npx prisma db push

# --- Supabase Direct Connection (untuk migrate/push) ---
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# --- Supabase Transaction Pooler (untuk Vercel/Production) ---
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

DATABASE_URL="postgresql://postgres.oiejgwjetguztlysnpqd:cempeda421@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# ImgBB API Key (opsional - bisa diisi lewat form upload di web)
# Daftar gratis di: https://api.imgbb.com/
IMGBB_API_KEY=""
