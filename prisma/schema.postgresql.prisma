generator client {
  provider = "prisma-client-js"
}

// ============================================
// DATABASE CONFIGURATION
// ============================================
// Lokal (SQLite):   provider = "sqlite",  url = "file:./db/custom.db"
// Supabase (PostgreSQL): provider = "postgresql", url = env("DATABASE_URL")
//
// Ganti provider sesuai environment kamu.
// ============================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Album {
  id          String    @id @default(cuid())
  name        String
  description String?
  category    String?
  coverUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  photos      Photo[]
  videos      Video[]
}

model Photo {
  id           String   @id @default(cuid())
  albumId      String
  filename     String
  url          String
  thumbnailUrl String?
  source       String   @default("imgbb")
  size         Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  album        Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
}

model Video {
  id          String   @id @default(cuid())
  albumId     String
  title       String
  url         String
  thumbnailUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  album       Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
}
